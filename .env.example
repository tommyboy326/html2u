# --- Core (required in production) ------------------------------------------

# Secret used to sign content-access / session tokens. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# --- Admin dashboard auth (/admin) ------------------------------------------
# Production: Google (Gmail) login restricted to ADMIN_EMAILS.
#   1. Create an OAuth 2.0 Client (Web) in Google Cloud Console.
#   2. Authorized redirect URI: https://<your-domain>/api/auth/callback/google
#   3. Put the client id/secret below.
# When AUTH_GOOGLE_ID + AUTH_GOOGLE_SECRET are set, Google login is enforced and
# the password fallback is disabled.
AUTH_SECRET=                       # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=you@gmail.com,teammate@gmail.com   # comma-separated allowlist

# Dev-only fallback: used ONLY when Google auth is not configured.
ADMIN_PASSWORD=

# --- Storage: Supabase (Postgres) -------------------------------------------
# Project URL + the SERVICE ROLE key (server-side only — never expose it).
# Run supabase/schema.sql once in the Supabase SQL editor.
# Leave blank locally to use the .data/ file store (dev only, not for serverless).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Abuse control: who may CREATE shares -----------------------------------
# Comma-separated ISO-3166 country codes allowed to create shares, matched
# against Vercel's x-vercel-ip-country edge header. VIEWING is always global, so
# links sent to overseas recipients still open — only creation is restricted
# (the spam vector). Defaults to "TW" (Taiwan only) when unset.
#   - Open to everyone:        CREATE_ALLOWED_COUNTRIES=        (empty disables it)
#   - Taiwan + a few others:   CREATE_ALLOWED_COUNTRIES=TW,HK,JP,US
# Fails open when no geo header exists (local dev / non-Vercel hosting).
CREATE_ALLOWED_COUNTRIES=TW

# --- Content isolation (recommended for a public service) -------------------
# Serve raw user HTML from a SEPARATE throwaway domain so malicious uploads can
# never affect the main app's origin / cookies / reputation. Both point at this
# same deployment. Leave blank to serve same-origin (still sandboxed + CSP).
#   CONTENT_ORIGIN: e.g. https://usercontent.example.com
#   APP_ORIGIN:     the main app origin (used for the content's frame-ancestors CSP)
CONTENT_ORIGIN=
APP_ORIGIN=
